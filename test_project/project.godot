; Headless test project for the Manalens Godot SDK.
; Run: godot --headless --path sdks/godot/test_project -- --endpoint=http://127.0.0.1:3291 --publishable-key=mana_pk_...
; addons/manalens is a symlink to ../../addons/manalens.

config_version=5

[application]

config/name="Manalens SDK Test"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7")

[autoload]

Manalens="*res://addons/manalens/manalens.gd"
